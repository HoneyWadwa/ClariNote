# LectureLens AI environment configuration
# Copy to `.env` (backend) and fill in your own values. Never commit real keys.

# --- AI -------------------------------------------------------------------
# API key for the OpenAI SDK. When unset the app runs in clearly-labelled
# demo mode with fixed sample output instead of live generation.
OPENAI_API_KEY=

# Model used for generation (documented default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- Limits ---------------------------------------------------------------
# Maximum uploaded file size in megabytes (TXT/PDF/DOCX)
MAX_FILE_MB=5
# Maximum accepted lecture-note length in characters (pasted text or extracted text)
MAX_TEXT_LENGTH=60000

# --- Server ---------------------------------------------------------------
# Port used when starting the Flask API directly (default: 5001)
PORT=5001
# Set to 1 to enable Flask debug mode (development only)
FLASK_DEBUG=0
